    <Compile Include="..\..\src\WinLab.Executor\ExecutorHost.cs" Link="Linked\ExecutorHost.cs" />
    <Compile Include="..\..\src\WinLab.Executor\Services\WindowsRegistryService.cs" Link="Linked\WindowsRegistryService.cs" />
    <Compile Include="..\..\src\WinLab.Executor\Services\WindowsUserHiveManager.cs" Link="Linked\WindowsUserHiveManager.cs" />
