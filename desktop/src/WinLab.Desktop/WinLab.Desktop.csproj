<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <LangVersion>12</LangVersion>
    <RootNamespace>WinLab.Desktop</RootNamespace>
    <AssemblyName>WinLab.Desktop</AssemblyName>
    <Version>0.9.1</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>WinLab.Desktop.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinLab.Contracts\WinLab.Contracts.csproj" />
    <ProjectReference Include="..\WinLab.Agent.Mock\WinLab.Agent.Mock.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2849.39" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="wwwroot\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
